{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    // Lets workflows pin tool versions with `# renovate:` comments
    "customManagers:githubActionsVersions"
  ],
  "labels": ["dependencies"],
  "reviewers": ["curantes"],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true,
  // Every mirror/images.yaml entry gets its own PR (48 entries). The default
  // limits (10 open PRs, 2 new per hour) would let a few PRs that fail the
  // mirror checks hold back the refreshes of every other entry.
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      // Upstream images approved for mirroring (mirror/images.yaml)
      "customType": "regex",
      "managerFilePatterns": ["/^mirror/images\\.yaml$/"],
      "matchStrings": [
        "source:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      // Each mirror/images.yaml entry is one version stream; only refresh its
      // digest. New streams are added as new entries.
      "matchPackageNames": ["/^registry\\.access\\.redhat\\.com/hi//"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      // Entries are not grouped: each digest refresh is its own PR, so an
      // image that fails the mirror checks doesn't block the others. The
      // branch name includes the tag so that tags of one repository
      // (hi/go:1.26, hi/go:1.27-builder) never share a branch.
      "matchPackageNames": ["/^registry\\.access\\.redhat\\.com/hi//"],
      "matchUpdateTypes": ["digest"],
      "branchTopic": "{{{depNameSanitized}}}-{{{currentValue}}}"
    },
    {
      // Everything the workflows pin, in one weekly PR: the actions in
      // `uses:` and the tool versions behind `# renovate:` comments (Syft,
      // Grype, regctl, the linters, kind, Kyverno). The tool versions come
      // from the regex manager, so the rule matches files, not a manager.
      // Tuesday, because the weekly re-audit and the policy test run on
      // Monday morning and a change to the mirror workflows checks every
      // entry again.
      "matchFileNames": [".github/workflows/**"],
      "matchPackageNames": ["!renovate"],
      "groupName": "github-actions-dependencies",
      "schedule": ["before 4am on tuesday"]
    },
    {
      // Low-risk updates merge on their own once the required checks pass;
      // Hummingbird digests are gated by signature verification and grype.
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "patch"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      // The VSA is trusted because verify-promote.yml on main signs it, so
      // changes to the actions and tools the mirror workflows run need a
      // human review. The other workflows get one too: the Policy workflow
      // that tests a new Kyverno or kind is not a required check, and the
      // updates share one PR anyway. After the rule above: later rules win.
      "matchFileNames": [".github/workflows/**"],
      "automerge": false
    },
    {
      // Renovate ships several releases a day. The pinned version only runs
      // renovate-config-validator, which the update's own Renovate Config
      // check exercises, so take one update a week and merge it unattended.
      // After the rule above: later rules win.
      "matchPackageNames": ["renovate"],
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["before 4am on tuesday"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      // Renovate updates the `runs-on` labels but not the labels in the
      // test-scan matrix of verify-promote.yml, which would leave the
      // workflows on two Ubuntu releases. Runner images are moved by hand.
      "matchDatasources": ["github-runners"],
      "enabled": false
    },
    {
      // Give upstream time to yank a bad release before it can automerge.
      // Not applied to image digests: they lack release timestamps and would
      // stay pending, and their refreshes usually carry CVE fixes.
      "matchDatasources": ["github-tags", "github-releases", "npm"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
